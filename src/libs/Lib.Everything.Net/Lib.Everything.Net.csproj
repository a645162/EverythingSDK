<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\EverythingSDK.Version.props" Condition="Exists('..\..\..\EverythingSDK.Version.props')" />
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Lib.Everything</RootNamespace>
    <AssemblyName>Lib.Everything</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Lib.Everything.Framework\src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\native\Everything32.dll">
      <Link>Everything32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\native\Everything64.dll">
      <Link>Everything64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\native\EverythingARM.dll">
      <Link>EverythingARM.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\native\EverythingARM64.dll">
      <Link>EverythingARM64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\..\..\EverythingSDK.Version.targets" Condition="Exists('..\..\..\EverythingSDK.Version.targets')" />
</Project>
