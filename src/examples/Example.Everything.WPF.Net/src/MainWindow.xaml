<Window x:Class="Example.Everything.WPF.Net.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Example.Everything.WPF.Net"
        Width="1100"
        Height="700"
        MinWidth="760"
        MinHeight="480">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusTextBlock" Text="Ready" />
      </StatusBarItem>
    </StatusBar>

    <TextBox x:Name="LogTextBox"
             DockPanel.Dock="Bottom"
             Height="120"
             Margin="8,0,8,8"
             IsReadOnly="True"
             VerticalScrollBarVisibility="Auto"
             AcceptsReturn="True"
             FontFamily="Consolas"
             Text="（错误与日志会显示在这里，可整段复制）" />

    <Border DockPanel.Dock="Top" Margin="8" Padding="8" BorderBrush="#DDDDDD" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="360" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="搜索" />
        <TextBox x:Name="SearchTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" />
        <Button x:Name="SearchButton" Grid.Row="0" Grid.Column="2" Width="88" Content="搜索" />

        <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,0,0">
          <CheckBox x:Name="MatchCaseCheckBox" Margin="0,0,12,0" Content="区分大小写" />
          <CheckBox x:Name="WholeWordCheckBox" Margin="0,0,12,0" Content="全字匹配" />
          <CheckBox x:Name="RegexCheckBox" Margin="0,0,12,0" Content="正则" />
          <CheckBox x:Name="MatchPathCheckBox" Margin="0,0,12,0" Content="匹配路径" />
          <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="排序" />
          <ComboBox x:Name="SortComboBox" Width="220" Margin="0,0,12,0" />
          <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="上限" />
          <TextBox x:Name="MaxTextBox" Width="80" Text="1000" />
        </WrapPanel>
      </Grid>
    </Border>

    <DataGrid x:Name="ResultsGrid"
              Margin="8,0,8,8"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              MouseDoubleClick="ResultsGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="路径" Width="*" Binding="{Binding Path}" />
        <DataGridTextColumn Header="大小" Width="120" Binding="{Binding Size}" />
        <DataGridTextColumn Header="修改时间" Width="160" Binding="{Binding Modified}" />
        <DataGridTextColumn Header="类型" Width="120" Binding="{Binding Type}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
